{
  "name": "documentation-reviewer",
  "version": "0.4.3",
  "private": true,
  "description": "ДокРевью — локальный read-only ревьюер технической документации",
  "main": "./out/main/index.js",
  "scripts": {
    "reviewer:dev": "electron-vite build && electron .",
    "reviewer:build": "electron-vite build",
    "reviewer:test": "vitest run",
    "reviewer:test:watch": "vitest",
    "reviewer:vscode:build": "esbuild extensions/vscode/src/extension.ts --bundle --platform=node --format=cjs --outfile=extensions/vscode/dist/extension.js --external:vscode",
    "reviewer:vscode:test": "vitest run tests/vscode"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@vitejs/plugin-react": "^5.0.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.0"
  }
}
